# macOS metadata
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Java compiled binaries and build directories
*.class
target/
out/
bin/
*.war
*.ear

# Maven
.mvn/
*.log

# IDE and Editor configurations
.idea/
*.iml
.vscode/
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/

# Apache Tomcat runtime directories
**/apache-tomcat-*/logs/*
**/apache-tomcat-*/temp/*
**/apache-tomcat-*/work/*
**/apache-tomcat-*/webapps/shopsphere/
**/apache-tomcat-*/webapps/servlet-basics/
**/apache-tomcat-*/webapps/servlet/
**/apache-tomcat-*/webapps/html-to-jsp/

# Sensitive database passwords and env files
.env
*.env.local
**/db.properties
!**/db.properties.example
**/bin/setenv.sh
!**/bin/setenv.sh.example
